<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_principal"
    tools:context=".Ventanas.RegistroUsuario">

    <ImageView
        android:id="@+id/imageView"
        android:layout_width="0dp"
        android:layout_height="240dp"
        android:layout_marginTop="30dp"
        android:background="@color/fondo_principal"
        android:scaleType="centerCrop"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/chatgpt_image_15_may_2026__10_40_58" />

    <TextView
        android:id="@+id/campoErrorRegistroUsuario"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:text="TextView"
        android:textColor="@color/error"
        android:textSize="13sp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imageView" />

    <EditText
        android:id="@+id/campoNombreUsuarioRegistroUsuario"
        android:layout_width="250dp"
        android:layout_height="50dp"
        android:layout_marginTop="25dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/edittext_selector"
        android:backgroundTint="@null"
        android:ems="10"
        android:hint="@string/Nombre_de_usuario"
        android:inputType="text"
        android:paddingLeft="7dp"
        android:textColor="@color/texto_principal"
        android:textColorHint="@color/texto_secundario"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imageView" />

    <EditText
        android:id="@+id/campoCorreoRegistroUsuario"
        android:layout_width="250dp"
        android:layout_height="50dp"
        android:layout_marginTop="35dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/edittext_selector"
        android:backgroundTint="@null"
        android:ems="10"
        android:hint="@string/Correo_electronico"
        android:inputType="textEmailAddress"
        android:paddingLeft="7dp"
        android:textColor="@color/texto_principal"
        android:textColorHint="@color/texto_secundario"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/campoNombreUsuarioRegistroUsuario" />

    <EditText
        android:id="@+id/campoPassRegistroUsuario"
        android:layout_width="250dp"
        android:layout_height="50dp"
        android:layout_marginTop="35dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/edittext_selector"
        android:backgroundTint="@null"
        android:ems="10"
        android:hint="@string/Contraseña"
        android:inputType="textPassword"
        android:paddingLeft="7dp"
        android:textColor="@color/texto_principal"
        android:textColorHint="@color/texto_secundario"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/campoCorreoRegistroUsuario" />

    <EditText
        android:id="@+id/campoConfirmarPassRegistroUsuario"
        android:layout_width="250dp"
        android:layout_height="50dp"
        android:layout_marginTop="35dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/edittext_selector"
        android:backgroundTint="@null"
        android:ems="10"
        android:hint="@string/Confirmar_contraseña"
        android:inputType="textPassword"
        android:paddingLeft="7dp"
        android:textColor="@color/texto_principal"
        android:textColorHint="@color/texto_secundario"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/campoPassRegistroUsuario" />

    <ImageView
        android:id="@+id/imagenNombreRegistro"
        android:layout_width="wrap_content"
        android:layout_height="50dp"
        android:layout_marginStart="15dp"
        android:layout_marginTop="23dp"
        android:layout_marginEnd="55dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/campoNombreUsuarioRegistroUsuario"
        app:layout_constraintTop_toBottomOf="@+id/imageView"
        app:srcCompat="@drawable/usuario_normal" />

    <ImageView
        android:id="@+id/imagenCorreoRegistro"
        android:layout_width="wrap_content"
        android:layout_height="50dp"
        android:layout_marginStart="15dp"
        android:layout_marginTop="35dp"
        android:layout_marginEnd="55dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/campoCorreoRegistroUsuario"
        app:layout_constraintTop_toBottomOf="@+id/imagenNombreRegistro"
        app:srcCompat="@drawable/email_normal" />

    <ImageView
        android:id="@+id/imagenPassRegistro"
        android:layout_width="wrap_content"
        android:layout_height="50dp"
        android:layout_marginStart="15dp"
        android:layout_marginTop="35dp"
        android:layout_marginEnd="55dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/campoPassRegistroUsuario"
        app:layout_constraintTop_toBottomOf="@+id/imagenCorreoRegistro"
        app:srcCompat="@drawable/pass_normal" />

    <ImageView
        android:id="@+id/imagenConfirmarPassRegistro"
        android:layout_width="wrap_content"
        android:layout_height="50dp"
        android:layout_marginStart="15dp"
        android:layout_marginTop="35dp"
        android:layout_marginEnd="55dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/campoConfirmarPassRegistroUsuario"
        app:layout_constraintTop_toBottomOf="@+id/imagenPassRegistro"
        app:srcCompat="@drawable/pass_normal" />

    <Button
        android:id="@+id/botonRegistrarseRegistroUsuario"
        android:layout_width="200dp"
        android:layout_height="55dp"
        android:layout_marginTop="22dp"
        android:backgroundTint="@color/color_principal"
        android:text="@string/Registrarse"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.497"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/campoConfirmarPassRegistroUsuario" />

    <Button
        android:id="@+id/botonIniciarSesionRegistroUsuario"
        android:layout_width="200dp"
        android:layout_height="55dp"
        android:layout_marginStart="160dp"
        android:layout_marginTop="15dp"
        android:layout_marginEnd="161dp"
        android:backgroundTint="@color/color_secundario"
        android:text="@string/Iniciar_sesion"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/botonRegistrarseRegistroUsuario" />

    <ImageView
        android:id="@+id/imagenVerPassConRegistroUsuario"
        android:layout_width="wrap_content"
        android:layout_height="50dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="192dp"
        android:layout_marginEnd="15dp"
        app:layout_constraintEnd_toStartOf="@+id/campoPassRegistroUsuario"
        app:layout_constraintHorizontal_bias="0.125"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imageView"
        app:srcCompat="@drawable/ojo_off" />

    <ImageView
        android:id="@+id/imagenVerPassConfConRegistroUsuario"
        android:layout_width="wrap_content"
        android:layout_height="50dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="36dp"
        android:layout_marginEnd="15dp"
        app:layout_constraintEnd_toStartOf="@+id/campoConfirmarPassRegistroUsuario"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imagenVerPassConRegistroUsuario"
        app:srcCompat="@drawable/ojo_off" />

</androidx.constraintlayout.widget.ConstraintLayout>