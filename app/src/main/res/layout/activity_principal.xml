<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_principal"
    tools:context=".Ventanas.Principal">

    <!-- HEADER -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraintLayout"
        android:layout_width="0dp"
        android:layout_height="250dp"
        android:background="@color/color_principal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- SALUDO -->
        <TextView
            android:id="@+id/campoSaludoUsuarioPrincipal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="24dp"
            android:text="Hola"
            android:textColor="@color/tarjetas_cards"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- PERFIL -->
        <ImageView
            android:id="@+id/imagenPerfilUsuarioPrincipal"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="24dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/bg_perfil"
            android:scaleType="centerInside"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/boton_perfil" />

        <!-- TEXTO SALDO -->
        <TextView
            android:id="@+id/textView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="20dp"
            android:text="Saldo actual"
            android:textColor="#88FFFFFF"
            android:textSize="12sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/campoSaludoUsuarioPrincipal" />

        <!-- SALDO -->
        <TextView
            android:id="@+id/campoSaldoActualPrincipal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="4dp"
            android:text="0,00€"
            android:textColor="@color/tarjetas_cards"
            android:textSize="38sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textView" />

        <!-- CARD INGRESOS -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="15dp"
            android:layout_marginEnd="8dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:layout_constraintEnd_toStartOf="@id/cardView2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/campoSaldoActualPrincipal">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#2E4B6B"
                android:padding="14dp">

                <ImageView
                    android:id="@+id/imageView7"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:background="@drawable/bg_ingreso"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:srcCompat="@drawable/ic_ingreso" />

                <TextView
                    android:id="@+id/textView5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:text="Ingresos"
                    android:textColor="#AFC3D6"
                    app:layout_constraintStart_toEndOf="@id/imageView7"
                    app:layout_constraintTop_toTopOf="@id/imageView7" />

                <TextView
                    android:id="@+id/campoIngresosCardPrincipal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginTop="2dp"
                    android:text="0€"
                    android:textColor="@color/ingreso"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toEndOf="@id/imageView7"
                    app:layout_constraintTop_toBottomOf="@id/textView5" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.cardview.widget.CardView>

        <!-- CARD GASTOS -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardView2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="15dp"
            android:layout_marginEnd="20dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/cardView"
            app:layout_constraintTop_toBottomOf="@id/campoSaldoActualPrincipal">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#2E4B6B"
                android:padding="14dp">

                <ImageView
                    android:id="@+id/imageView8"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:background="@drawable/bg_gasto"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:srcCompat="@drawable/ic_gasto" />

                <TextView
                    android:id="@+id/textView6"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:text="Gastos"
                    android:textColor="#AFC3D6"
                    app:layout_constraintStart_toEndOf="@id/imageView8"
                    app:layout_constraintTop_toTopOf="@id/imageView8" />

                <TextView
                    android:id="@+id/campoGastosCardPrincipal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginTop="2dp"
                    android:text="0€"
                    android:textColor="@color/gasto"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toEndOf="@id/imageView8"
                    app:layout_constraintTop_toBottomOf="@id/textView6" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- RESUMEN -->
    <!-- RESUMEN -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardView3"
        android:layout_width="0dp"
        android:layout_height="230dp"
        android:layout_marginStart="15dp"
        android:layout_marginTop="15dp"
        android:layout_marginEnd="15dp"
        android:background="@drawable/bordes_card"
        android:padding="1dp"
        app:cardCornerRadius="22dp"
        app:cardElevation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/constraintLayout">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bordes_card">

            <TextView
                android:id="@+id/textView4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="25dp"
                android:layout_marginTop="20dp"
                android:text="@string/Resumen"
                android:textColor="@color/texto_principal"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/campoEsteMesPrincipal"
                android:layout_width="75dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="120dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="108dp"
                android:background="@drawable/tab_activo"
                android:gravity="center"
                android:padding="3dp"
                android:text="@string/EsteMes"
                android:textColor="@color/tarjetas_cards"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/textView4"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/campoGeneralPrincipal"
                android:layout_width="75dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="29dp"
                android:background="@drawable/tab_inactivo"
                android:gravity="center"
                android:padding="3dp"
                android:text="@string/General"
                android:textColor="@color/texto_principal"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/campoEsteMesPrincipal"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/textBalanceTitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="22dp"
                android:layout_marginTop="45dp"
                android:text="Balance"
                android:textColor="@color/texto_secundario"
                android:textSize="12sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/campoEsteMesPrincipal" />

            <TextView
                android:id="@+id/campoPorcentajeBalancePrincipal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="+0%"
                android:textColor="@color/ingreso"
                android:textSize="28sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="@id/textBalanceTitulo"
                app:layout_constraintTop_toBottomOf="@id/textBalanceTitulo" />

            <TextView
                android:id="@+id/textIngresosVsGastos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Ingresos\nvs gastos"
                android:textColor="@color/texto_secundario"
                android:textSize="12sp"
                app:layout_constraintStart_toStartOf="@id/campoPorcentajeBalancePrincipal"
                app:layout_constraintTop_toBottomOf="@id/campoPorcentajeBalancePrincipal" />

            <com.github.mikephil.charting.charts.PieChart
                android:id="@+id/graficaResumen"
                android:layout_width="145dp"
                android:layout_height="145dp"
                android:layout_marginStart="115dp"
                android:layout_marginTop="28dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/campoEsteMesPrincipal" />

            <TextView
                android:id="@+id/textView7"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="30dp"
                android:layout_marginTop="50dp"
                android:text="@string/Ingresos"
                android:textColor="@color/texto_secundario"
                android:textSize="12sp"
                app:layout_constraintStart_toEndOf="@id/graficaResumen"
                app:layout_constraintTop_toBottomOf="@+id/campoEsteMesPrincipal" />

            <TextView
                android:id="@+id/textView8"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="30dp"
                android:layout_marginTop="20dp"
                android:text="@string/Gastos"
                android:textColor="@color/texto_secundario"
                android:textSize="12sp"
                app:layout_constraintStart_toEndOf="@id/graficaResumen"
                app:layout_constraintTop_toBottomOf="@+id/campoIngresosResumenPrincipal" />

            <TextView
                android:id="@+id/campoIngresosResumenPrincipal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="30dp"
                android:layout_marginTop="2dp"
                android:text="TextView"
                android:textStyle="bold"
                app:layout_constraintStart_toEndOf="@id/graficaResumen"
                app:layout_constraintTop_toBottomOf="@+id/textView7" />

            <TextView
                android:id="@+id/campoGastosResumenPrincipal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="30dp"
                android:layout_marginTop="2dp"
                android:text="TextView"
                android:textStyle="bold"
                app:layout_constraintStart_toEndOf="@id/graficaResumen"
                app:layout_constraintTop_toBottomOf="@+id/textView8" />

            <ImageView
                android:id="@+id/imageView6"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginStart="13dp"
                android:layout_marginTop="108dp"
                app:layout_constraintStart_toEndOf="@id/graficaResumen"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/azul_grafica" />

            <ImageView
                android:id="@+id/imageView9"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginStart="13dp"
                android:layout_marginTop="49dp"
                app:layout_constraintStart_toEndOf="@id/graficaResumen"
                app:layout_constraintTop_toBottomOf="@+id/imageView6"
                app:srcCompat="@drawable/rojo_grafica" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>

    <!-- CARD MOVIMIENTOS -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardUltimoMovimiento"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="15dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="15dp"
        app:cardCornerRadius="22dp"
        app:cardElevation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardView3">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bordes_card"
            android:padding="18dp">

            <!-- TITULO -->
            <TextView
                android:id="@+id/textUltimoMovimiento"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Últimos movimientos"
                android:textColor="@color/texto_principal"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- MOVIMIENTO 1 -->
            <ImageView
                android:id="@+id/iconoMovimiento"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:layout_marginTop="15dp"
                android:background="@drawable/bg_ingreso"
                android:padding="10dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/textUltimoMovimiento"
                app:srcCompat="@drawable/ic_compras" />

            <TextView
                android:id="@+id/campoTituloMovimiento"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:text="Compra"
                android:textColor="@color/texto_principal"
                android:textSize="15sp"
                android:textStyle="bold"
                app:layout_constraintStart_toEndOf="@id/iconoMovimiento"
                app:layout_constraintTop_toTopOf="@id/iconoMovimiento" />

            <TextView
                android:id="@+id/campoFechaMovimiento"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginTop="3dp"
                android:text="Hoy · Alimentación"
                android:textColor="@color/texto_secundario"
                android:textSize="12sp"
                app:layout_constraintStart_toEndOf="@id/iconoMovimiento"
                app:layout_constraintTop_toBottomOf="@id/campoTituloMovimiento" />

            <TextView
                android:id="@+id/campoImporteMovimiento"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-45,20€"
                android:textColor="@color/gasto"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@id/iconoMovimiento"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/iconoMovimiento" />

            <!-- MOVIMIENTO 2 -->

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutMovimiento2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/iconoMovimiento">

            <ImageView
                android:id="@+id/iconoMovimiento2"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:background="@drawable/bg_ingreso"
                android:padding="10dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/ic_compras" />

            <TextView
                android:id="@+id/campoTituloMovimiento2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:text="Compra"
                android:textColor="@color/texto_principal"
                android:textSize="15sp"
                android:textStyle="bold"
                app:layout_constraintStart_toEndOf="@id/iconoMovimiento2"
                app:layout_constraintTop_toTopOf="@id/iconoMovimiento2" />

            <TextView
                android:id="@+id/campoFechaMovimiento2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginTop="3dp"
                android:text="Hoy · Alimentación"
                android:textColor="@color/texto_secundario"
                android:textSize="12sp"
                app:layout_constraintStart_toEndOf="@id/iconoMovimiento2"
                app:layout_constraintTop_toBottomOf="@id/campoTituloMovimiento2" />

            <TextView
                android:id="@+id/campoImporteMovimiento2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-45,20€"
                android:textColor="@color/gasto"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@id/iconoMovimiento2"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/iconoMovimiento2" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>

    <!-- BOTON AGREGAR -->

    <!-- MENU -->

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/botonAgregarMovimientoPrincipal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="35dp"
        android:contentDescription="Agregar Movimiento Nuevo"
        android:src="@drawable/anadir"
        android:translationY="-18dp"
        app:backgroundTint="@color/color_secundario"
        app:fabCustomSize="56dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardUltimoMovimiento"
        app:maxImageSize="24dp"
        app:tint="@android:color/white" />

    <androidx.cardview.widget.CardView
        android:id="@+id/cardBottomMenu"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"
        android:layout_marginBottom="15dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNavigation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bordes_card"
            app:itemIconTint="@null"
            app:itemTextColor="@color/bottom_nav_colors"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/bottom_menu" />

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>