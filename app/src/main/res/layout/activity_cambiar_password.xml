<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_principal"
    tools:context=".Ventanas.CambiarPassword">


    <!-- BOTON VOLVER -->

    <ImageView
        android:id="@+id/botonVolver"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="30dp"
        android:scaleType="centerCrop"
        android:src="@drawable/flecha_atras"
        app:tint="@color/texto_principal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <!-- TITULO -->

    <TextView
        android:id="@+id/textTitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="150dp"
        android:text="Cambiar contraseña"
        android:textColor="@color/texto_principal"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <!-- SUBTITULO -->

    <TextView
        android:id="@+id/textSubtitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Actualiza tu contraseña de acceso"
        android:textColor="@color/texto_secundario"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textTitulo" />


    <!-- PASSWORD ACTUAL -->

    <EditText
        android:id="@+id/editPasswordActual"
        android:layout_width="250dp"
        android:layout_height="58dp"
        android:layout_marginStart="28dp"
        android:layout_marginTop="42dp"
        android:layout_marginEnd="28dp"
        android:background="@drawable/edittext_selector"
        android:hint="Contraseña actual"
        android:inputType="textPassword"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:textColor="@color/texto_principal"
        android:textColorHint="@color/texto_secundario"
        android:textSize="15sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textSubtitulo" />


    <!-- NUEVA PASSWORD -->

    <EditText
        android:id="@+id/editNuevaPassword"
        android:layout_width="250dp"
        android:layout_height="58dp"
        android:layout_marginStart="28dp"
        android:layout_marginTop="18dp"
        android:layout_marginEnd="28dp"
        android:background="@drawable/edittext_selector"
        android:hint="Nueva contraseña"
        android:inputType="textPassword"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:textColor="@color/texto_principal"
        android:textColorHint="@color/texto_secundario"
        android:textSize="15sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/editPasswordActual" />


    <!-- CONFIRMAR PASSWORD -->

    <EditText
        android:id="@+id/editConfirmarPassword"
        android:layout_width="250dp"
        android:layout_height="58dp"
        android:layout_marginStart="28dp"
        android:layout_marginTop="18dp"
        android:layout_marginEnd="28dp"
        android:background="@drawable/edittext_selector"
        android:hint="Confirmar nueva contraseña"
        android:inputType="textPassword"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:textColor="@color/texto_principal"
        android:textColorHint="@color/texto_secundario"
        android:textSize="15sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/editNuevaPassword" />


    <!-- BOTON GUARDAR -->

    <TextView
        android:id="@+id/botonGuardarPassword"
        android:layout_width="250dp"
        android:layout_height="58dp"
        android:layout_marginStart="28dp"
        android:layout_marginTop="34dp"
        android:layout_marginEnd="28dp"
        android:background="@drawable/tab_activo"
        android:gravity="center"
        android:text="Guardar cambios"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/editConfirmarPassword" />

    <TextView
        android:id="@+id/textErrorCambiarPassword"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="TextView"
        android:textColor="@color/error"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textSubtitulo" />

    <ImageView
        android:id="@+id/imagenVePassAcCambiarPassword"
        android:layout_width="wrap_content"
        android:layout_height="58dp"
        android:layout_marginTop="42dp"
        android:layout_marginEnd="19dp"
        app:layout_constraintEnd_toStartOf="@+id/editPasswordActual"
        app:layout_constraintTop_toBottomOf="@+id/textSubtitulo"
        app:srcCompat="@drawable/ojo_off" />

    <ImageView
        android:id="@+id/imagenVePassNueCambiarPassword"
        android:layout_width="wrap_content"
        android:layout_height="58dp"
        android:layout_marginTop="18dp"
        android:layout_marginEnd="19dp"
        app:layout_constraintEnd_toStartOf="@+id/editNuevaPassword"
        app:layout_constraintTop_toBottomOf="@+id/imagenVePassAcCambiarPassword"
        app:srcCompat="@drawable/ojo_off" />

    <ImageView
        android:id="@+id/imagenVePassConCambiarPassword"
        android:layout_width="wrap_content"
        android:layout_height="58dp"
        android:layout_marginTop="18dp"
        android:layout_marginEnd="19dp"
        app:layout_constraintEnd_toStartOf="@+id/editConfirmarPassword"
        app:layout_constraintTop_toBottomOf="@+id/imagenVePassNueCambiarPassword"
        app:srcCompat="@drawable/ojo_off" />


</androidx.constraintlayout.widget.ConstraintLayout>